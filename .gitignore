# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (examples are committed)
!.env.example

# testing artefacts
/playwright-report
/test-results
/blob-report

# firebase emulators
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
/.emulator-data

# generated placeholder imagery (npm run placeholders)
/public/media/placeholders
