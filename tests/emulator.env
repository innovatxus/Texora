# Test-only environment: the automated suites run against the local Firebase
# emulators with an offline "demo-" project, never a real one. Loaded by
# tests/e2e-run.ts and playwright.config.ts; the app itself never reads it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-texora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-texora
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-texora.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_PROJECT_ID=demo-texora
FIREBASE_STORAGE_BUCKET=demo-texora.appspot.com
USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_SERVICE_ACCOUNT=
ENABLE_STYLEGUIDE=true
STAGING=false
RESEND_API_KEY=
ORDER_TOKEN_SECRET=e2e-order-token-secret-not-for-production-0001
CRON_SECRET=e2e-cron-secret-not-for-production-000000000001
EMAIL_FROM=Texora <orders@texora.test>
NEXT_DIST_DIR=.next-e2e
# Blank on purpose: stops keys in .env.local reaching the test build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
