# Copy to .env.local and fill in your Firebase project (Project settings → Your apps
# → Web app, and Service accounts). .env.local is git-ignored: never commit it.
# Never put secrets in NEXT_PUBLIC_* variables (they're visible in the browser).

# --- Public (inlined into the browser bundle; protected by the security rules) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server only ---
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Base64 of the service-account JSON (Project settings → Service accounts). Secret.
FIREBASE_SERVICE_ACCOUNT=

# A test deployment: blocks search indexing and, without RESEND_API_KEY, writes
# emails to the Firestore emailOutbox collection. Remove for the public launch.
STAGING=true
# Internal component catalogue at /styleguide; keep false on any deployment.
ENABLE_STYLEGUIDE=false

# --- Orders, payments and email ---
# 32+ random characters each.
ORDER_TOKEN_SECRET=
CRON_SECRET=
# Card payments (Stripe). Leave blank to offer Cash on Delivery only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Transactional email via Resend (required in production unless STAGING=true).
RESEND_API_KEY=
EMAIL_FROM=Texora <orders@your-domain.com>
