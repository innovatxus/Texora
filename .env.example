# Copy to .env.local for local development. These defaults target the local
# Firebase emulators with the offline "demo-" project, so no real credentials
# are needed. Never put secrets in NEXT_PUBLIC_* variables.

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-texora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-texora
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-texora.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- Server only ---
FIREBASE_PROJECT_ID=demo-texora
FIREBASE_STORAGE_BUCKET=demo-texora.appspot.com
USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Internal component catalogue at /styleguide (local + CI only, never production).
ENABLE_STYLEGUIDE=true
# A test deployment of a production build: blocks search indexing and, without
# RESEND_API_KEY, writes emails to the Firestore emailOutbox. Never on the public site.
# STAGING=true
# Base64-encoded service-account JSON; required in production with emulators off.
# FIREBASE_SERVICE_ACCOUNT=

# --- Orders, payments and email ---
# Signs guest order-confirmation links. Use 32+ random characters in production.
ORDER_TOKEN_SECRET=local-dev-order-token-secret-change-me-0001
# Card payments (Stripe test mode). Leave unset to offer Cash on Delivery only.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Transactional email via Resend; unset locally writes mail to the Firestore emailOutbox collection.
# RESEND_API_KEY=re_...
EMAIL_FROM=Texora <orders@texora.test>
# Bearer token for scheduled jobs: POST /api/cron/release-reservations (every 5 min)
# and POST /api/cron/notifications (hourly: product alerts, scheduled e-gift cards).
CRON_SECRET=local-dev-cron-secret-change-me-000000000001
