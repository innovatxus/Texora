{
  "name": "texora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "budget": "node scripts/bundle-budget.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-texora-rules \"vitest run -c vitest.rules.config.mts\"",
    "test:integration": "firebase emulators:exec --only firestore,auth,storage --project demo-texora-it \"vitest run -c vitest.integration.config.mts\"",
    "e2e": "npm run test:e2e --",
    "e2e:visual": "npm run test:e2e -- --grep @visual",
    "e2e:visual:update": "npm run test:e2e -- --grep @visual --update-snapshots",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "contrast": "node scripts/contrast.mjs",
    "contrast:check": "node scripts/contrast.mjs --check",
    "rules:generate": "tsx scripts/generate-rules.ts",
    "rules:check": "tsx scripts/generate-rules.ts --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run contrast:check && npm run rules:check && npm run test && npm run build",
    "prepare": "husky",
    "test:e2e": "tsx tests/e2e-run.ts",
    "prebuild": "tsx scripts/check-env.ts",
    "migrate:egypt": "tsx scripts/migrate-egypt-settings.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.2.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
